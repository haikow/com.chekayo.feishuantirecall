<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.chekayo.feishuantirecall"
    android:versionCode="25"
    android:versionName="1.8.3">

    <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="34" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="FeishuKit"
        android:icon="@drawable/module_logo">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="FeishuKit：防撤回 / 防已读 / 离职档案。设置在飞书「设置 → 实验室」后的「模块设置」" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposedscope" />

        <!--
          模块设置页（也是桌面入口）。
          LSPosed / EdXposed 模块详情里的「启动/设置」会走 MAIN+LAUNCHER 的 Launch Intent，
          因此必须保持本 Activity exported + enabled，并带 LAUNCHER category。
        -->
        <activity
            android:name=".LauncherActivity"
            android:label="FeishuKit"
            android:exported="true"
            android:enabled="true"
            android:theme="@style/FeishuKitLauncher"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 配置权威源：飞书进程经 ContentProvider 与模块进程对齐 fucklark_cfg.json -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="com.chekayo.feishuantirecall.config"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- 同事档案/离职名单副本接收：飞书侧 ArchiveSync 显式包名广播（兼容 Android 11+ 包可见性） -->
        <receiver
            android:name=".ArchiveSync$Receiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.chekayo.feishuantirecall.ARCHIVE_PUSH" />
            </intent-filter>
        </receiver>

        <!-- 组织架构自动巡游:AccessibilityService 跑在模块自己的进程 -->
        <service
            android:name=".OrgWalkerService"
            android:label="FeishuKit 组织巡游"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
